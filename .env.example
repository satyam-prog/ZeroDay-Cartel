# ============================================================================
# FoodBridge - Environment Variable Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env and supply secure values.
# ============================================================================

# Database Configuration
POSTGRES_DB=foodbridge
POSTGRES_USER=foodbridge_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_32_CHAR_RANDOM_SECRET
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache & Broker Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_32_CHAR_RANDOM_SECRET

# Application Environment
NODE_ENV=production
API_BASE_URL=https://api.foodbridge.org
CLIENT_ORIGIN=https://foodbridge.org

# Cryptographic Keys (RS256 for JWT & Receipt HMAC)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX_KEY
RECEIPT_SIGNING_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX_KEY

# Third-Party Dispatch & Notification Gateways
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
SENTRY_DSN=

